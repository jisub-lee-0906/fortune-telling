# =========================
# Fortune Telling environment template
# =========================

# Paid Gemini interpretation is fail-closed by default.
INTERPRET_ENABLED=false
GEMINI_API_KEY=replace-with-a-server-only-key
INTERPRET_SERVER_TOKEN=replace-with-a-long-random-server-only-token
INTERPRET_REQUESTS_PER_MINUTE=10
INTERPRET_MAX_CONCURRENCY=2

HOST=0.0.0.0
PORT=8000
FRONTEND_URLS=https://your-frontend-domain.example.com,http://localhost:3000

FRONTEND_HOST_PORT=3001
# Server-only URL used by the Next.js route handler. Do not use NEXT_PUBLIC for secrets.
BACKEND_API_URL=http://backend:8000
