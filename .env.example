# Backend
GEMINI_API_KEY=your_gemini_api_key_here

# CORS (comma-separated)
FRONTEND_URLS=http://localhost:3000,https://localhost:3000

# Host port for frontend container to host (change if 3001 is used already)
FRONTEND_HOST_PORT=3001

# If you use compose with external domains in production, set accordingly.
FRONTEND_URLS=https://your-frontend-domain.example.com
NEXT_PUBLIC_API_URL=https://your-backend-domain.example.com
