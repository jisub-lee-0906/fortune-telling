# =========================
# Fortune Telling .env template (root)
# Copy to `.env` and use as the single source for docker-compose (local + Coolify).
# =========================

# Backend
GEMINI_API_KEY=your_gemini_api_key_here

# Backend runtime
HOST=0.0.0.0
PORT=8000

# CORS for backend (comma-separated). Must include actual frontend domain.
FRONTEND_URLS=https://your-frontend-domain.example.com,http://localhost:3000

# Frontend runtime
FRONTEND_HOST_PORT=3001
NEXT_PUBLIC_API_URL=https://your-backend-domain.example.com

# Optional local/test override (when not using external domains)
# NEXT_PUBLIC_API_URL=http://backend:8000
